rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'superadmin';
    }

    function ownsDocument() {
      return signedIn() && resource.data.user_id == request.auth.uid;
    }

    function createsOwnDocument() {
      return signedIn() && request.resource.data.user_id == request.auth.uid;
    }

    match /users/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || isSuperAdmin());
      allow list: if isSuperAdmin();
      // User profiles and roles are provisioned in the Firebase Console, not by the client.
      allow create, update, delete: if false;
    }

    match /entries/{entryId} {
      allow read: if ownsDocument() || isSuperAdmin();
      allow create: if createsOwnDocument();
      allow update, delete: if ownsDocument() || isSuperAdmin();
    }

    match /dropdown_options/{optionId} {
      allow read: if ownsDocument() || isSuperAdmin();
      allow create: if createsOwnDocument();
      allow update, delete: if ownsDocument();
    }

    match /gammes/{gammeId} {
      allow read: if ownsDocument() || isSuperAdmin();
      allow create: if createsOwnDocument();
      allow update, delete: if ownsDocument();
    }

    match /production_lines/{lineId} {
      allow read: if ownsDocument() || isSuperAdmin();
      allow create: if createsOwnDocument();
      allow update, delete: if ownsDocument();
    }
  }
}